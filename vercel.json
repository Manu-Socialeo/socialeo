{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/services", "destination": "/service.html" },
    { "source": "/projects", "destination": "/project.html" },
    { "source": "/blogs", "destination": "/blog.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
